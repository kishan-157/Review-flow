# LocalBoost AI Environment Configuration
# Copy this file to .env.local (for Next.js) or .env (for Vite)

# Supabase Public Configuration (Safe for client browsers)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Vite compatibility equivalents
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only Secret Key (NEVER expose to browser client code)
# Used only by backend administrative tasks and seed migrations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Application Base URL (Used for QR code URLs, OAuth callbacks, and review page links)
# Vercel will automatically provide VERCEL_URL, or set this to your custom domain
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"
